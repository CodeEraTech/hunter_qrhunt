# ==============================================================================
# HUNTER WALLET CONFIGURATION (.env)
# Rename this file to .env on your server and fill in your database details.
# ==============================================================================

# Application Environment: 'production' or 'development'
APP_ENV=production

# Set APP_DEBUG=true during initial setup to display any database or server errors.
# Set APP_DEBUG=false once site is verified.
APP_DEBUG=true

# Canonical URL of your site (HTTPS in production)
APP_URL=https://scancash.online

# 32+ character encryption secret
APP_KEY=hunter_wallet_prod_sec_key_9823489234892384928349283492

# ------------------------------------------------------------------------------
# cPanel Database Settings
# ------------------------------------------------------------------------------
# In cPanel, DB_HOST is usually 'localhost' or '127.0.0.1'
DB_HOST=localhost
DB_PORT=3306

# Your cPanel database name (e.g. scancash_hunter_wallet)
DB_NAME=scancash_hunter_wallet

# Your cPanel database username (e.g. scancash_admin)
DB_USER=scancash_db_user

# The password you set for the MySQL user in cPanel
DB_PASS=your_cpanel_db_password

# ------------------------------------------------------------------------------
# Security & Session Settings
# ------------------------------------------------------------------------------
SESSION_TIMEOUT=1800
COOKIE_SECURE=1

# Webhook Secrets (Optional / Payment Gateway)
RAZORPAY_WEBHOOK_SECRET=
PHONEPE_WEBHOOK_SECRET=

# Backup configuration
BACKUP_DIR=/path/outside/web-root/hunter-wallet-backups
BACKUP_RETENTION_DAYS=7
